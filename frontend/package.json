{
  "name": "perfagent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "demo:build": "tsc -b && vite build --mode demo",
    "demo": "npm run demo:build && vite preview --mode demo --host 127.0.0.1 --port 4174 --strictPort",
