    "api:types": "node scripts/generate-api.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
