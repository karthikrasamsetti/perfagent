# Copy this file to `.env` and fill in the values. `.env` is read automatically.

# Which provider to plan with: "openai" or "anthropic"
LLM_PROVIDER=openai

# Fill in the key for whichever provider you use (leave the other blank).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-2024-11-20
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Max tokens for the planning response
MAX_TOKENS=4096
