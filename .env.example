# ════════════════════════════════════════════════════════════════════════════
#  PerfAgent settings
#
#  Copy this file to `.env` (same folder) and edit the values. `.env` is read
#  automatically when the app starts, so RESTART THE APP after changing it.
#  `.env` is git-ignored — never commit it.
#
#  Every line here is optional except the API key for the provider you use.
#  A line that is commented out (starts with #) or missing uses the default
#  shown next to it. Names are not case-sensitive.
# ════════════════════════════════════════════════════════════════════════════


# ── 1. AI provider (required) ───────────────────────────────────────────────
# Which provider drafts plans, answers in chat and writes report summaries:
# "openai" or "anthropic".                                   Default: openai
LLM_PROVIDER=openai

# The key for the provider chosen above (leave the other one blank).
# Tip: set a spend cap on your provider account before using the AI features.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model used for each provider.
#   Default: gpt-4o-2024-11-20   /   claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4o-2024-11-20
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Largest AI response, in tokens.                            Default: 4096
MAX_TOKENS=4096


# ── 2. Database ─────────────────────────────────────────────────────────────
# Where everything is stored: plans, scripts, runs, reports, audit, traces,
# saved integration details and chat conversations.
#
# DEFAULT (line below left commented): SQLite — a file `perfagent.db` in the
# folder you start the app from. Nothing to install.
#
# To use POSTGRES, uncomment the line and put in your own values:
#   postgresql://<user>:<password>@<host>:<port>/<database>
# - Create the database first (it can be empty; the app creates its tables):
#       CREATE USER perfagent WITH PASSWORD 'choose-a-password';
#       CREATE DATABASE perfagent OWNER perfagent;
# - Special characters in the password must be URL-encoded:
#       @ -> %40     : -> %3A     / -> %2F     # -> %23     % -> %25
# - Postgres starts empty; data in an existing perfagent.db is not copied.
# - To go back to SQLite, comment the line out again.
# Check which one is in use: open http://127.0.0.1:<port>/api/health
#
# DATABASE_URL=postgresql://perfagent:choose-a-password@localhost:5432/perfagent

# Connections kept open to Postgres (ignored for SQLite).    Default: 5
# DATABASE_POOL_SIZE=5


# ── 3. Conversation mode (the multi-turn chat on Step 1) ────────────────────
# Show the "Conversation" tab. false = only Quick and Manual.  Default: true
CHAT_CONVERSATION_ENABLED=true

# Where conversations are saved.                             Default: (empty)
#   empty        follow the main database: the same Postgres database when
#                DATABASE_URL is Postgres, otherwise the file perfagent_chat.db
#   a file path  a SQLite file, e.g. C:\data\chats.db
#   postgresql://...   a specific Postgres database
#   :memory:     do not save; conversations are lost on restart
# CHAT_CHECKPOINT_DB=

# Most user messages in one conversation.                    Default: 40
CHAT_MAX_TURNS=40

# How many recent messages are re-sent to the AI each turn (the draft carries
# the rest, so this can stay small; higher = more tokens).   Default: 12
CHAT_HISTORY_WINDOW=12

# Largest single chat message, in characters.                Default: 8000
CHAT_MAX_MESSAGE_CHARS=8000


# ── 4. Logging ──────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR.                            Default: INFO
LOG_LEVEL=INFO

# Guardrail debug. true = log the REDACTED prompt sent to the AI, so you can
# confirm no sensitive data gets through. Only redacted text is logged, never
# raw secrets. Turn on to verify, then turn off again.       Default: false
GUARDRAIL_DEBUG=false


# ── 5. k6 load engine (optional) ────────────────────────────────────────────
# k6 is downloaded automatically on the first run. Set this to use a specific
# k6 instead (e.g. a machine without internet access).       Default: (auto)
# PERFAGENT_K6_PATH=C:\tools\k6\k6.exe

# Folder for PerfAgent's own files, including the downloaded k6.
#                                                            Default: ~/.perfagent
# PERFAGENT_HOME=


# ── 6. Git save / import (optional, for whoever hosts the app) ──────────────
# The repository URL, branch and token are typed in the UI each time and are
# never stored here.
# Author shown on PerfAgent's commits.
#   Default: PerfAgent / perfagent@localhost
GIT_AUTHOR_NAME=PerfAgent
GIT_AUTHOR_EMAIL=perfagent@localhost

# Git hosts users may push to / import from, comma-separated, e.g.
# github.com,dev.azure.com. Empty = any host.                Default: (empty)
GIT_ALLOWED_HOSTS=

# Allow local folders / file:// as repositories. For tests and local demos
# only — keep false when hosted.                             Default: false
# GIT_ALLOW_LOCAL=false


# ── 7. Jenkins (optional, for whoever hosts the app) ────────────────────────
# The Jenkins URL, user and API token are typed in the UI and never stored.
# Jenkins hosts users may call, comma-separated, e.g. jenkins.mycorp.com.
# Empty = any host.                                          Default: (empty)
JENKINS_ALLOWED_HOSTS=


# ── Tests only (not read by the app) ────────────────────────────────────────
# Set this in your shell — not here — to run the whole test suite against
# Postgres instead of SQLite. Use a separate, empty database:
#   PowerShell:  $env:PERFAGENT_TEST_DATABASE_URL="postgresql://user:pw@localhost:5432/perfagent_test"
#   then:        uv run pytest -q -n auto