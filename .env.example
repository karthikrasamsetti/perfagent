# Copy this file to `.env` and fill in the values. `.env` is read automatically.

# ── LLM provider ────────────────────────────────────────────────────
# Which provider to plan/narrate with: "openai" or "anthropic"
LLM_PROVIDER=openai

# Fill in the key for whichever provider you use (leave the other blank).
# Tip: set a spend cap on your provider account before using the AI features.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-2024-11-20
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Max tokens for the planning / narration response
MAX_TOKENS=4096

# ── Logging / guardrail debug ───────────────────────────────────────
# Log level for the structured logs (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Guardrail debug: when 1, logs the REDACTED prompt actually sent to the LLM
# (and output-scrub results) so you can confirm no sensitive data survives.
# It logs ONLY the redacted text, never raw secrets. Keep this 0 for normal use;
# set it to 1 temporarily when you want to verify redaction, then set it back.
GUARDRAIL_DEBUG=0

# ---- k6 load engine (optional) ----
# k6 is downloaded automatically on first run if it isn't found. Set this to use a
# specific k6 binary instead (e.g. offline / air-gapped machines):
# PERFAGENT_K6_PATH=C:\tools\k6\k6.exe
# Base folder for PerfAgent's own files, including the downloaded k6 (default ~/.perfagent):
# PERFAGENT_HOME=

# ---- Git export / import (optional, server admin only) ----
# Users enter the repository URL, branch and token in the UI for each push or import.
# Name/email shown as the author of PerfAgent's commits:
GIT_AUTHOR_NAME=PerfAgent
GIT_AUTHOR_EMAIL=perfagent@localhost
# Comma-separated Git hosts users may push to / import from (empty = any host)
GIT_ALLOWED_HOSTS=

# ---- Jenkins (optional, server admin only) ----
# Users enter the Jenkins URL, user name and API token in the UI; nothing is stored.
# Comma-separated Jenkins hosts users may call (empty = any host)
JENKINS_ALLOWED_HOSTS=
