{% endif %}
{% endfor %}
{% endfor %}

class GeneratedLoadShape(LoadTestShape):
    """Drives the ramp/spike/soak stages defined in the LoadModel."""

    stages = [
{% for s in shape_stages %}
        {"duration": {{ s.cumulative }}, "users": {{ s.users }}, "spawn_rate": {{ s.spawn_rate }}},
{% endfor %}
    ]

    def tick(self):
        run_time = self.get_run_time()
        for stage in self.stages:
            if run_time < stage["duration"]:
                return (stage["users"], stage["spawn_rate"])
        return None
