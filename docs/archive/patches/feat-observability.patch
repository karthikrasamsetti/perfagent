index 0000000..ae78c99
--- /dev/null
+++ b/src/perfagent/api/reporting_routes.py
@@ -0,0 +1,90 @@
+"""Reporting endpoints. Classified x-access=read, x-uses-ai=false.
+
+Answers the three stakeholder questions:
+  /reporting/runs     -> what happened across runs (history)
+  /reporting/trend    -> how a metric moves over time in prod
+  /reporting/coverage -> what's covered vs. what needs to complete
+"""
+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+
+import structlog
+from fastapi import APIRouter, Depends, Query
+from sqlalchemy import select, func
+from sqlalchemy.orm import Session
+
+from perfagent.db.connection import get_session      # existing dependency
+from perfagent.db.models import RunRecord
+from perfagent.reporting.service import Role, project
+from perfagent.reporting.flow_inventory import load_inventory
+
+log = structlog.get_logger("perfagent.api.reporting")
+router = APIRouter(prefix="/reporting", tags=["reporting"])
+
+
+@router.get("/runs")   # x-access: read
+def list_runs(
+    role: Role = Query(Role.VIEWER),
+    environment: str | None = Query(None),
+    scenario: str | None = Query(None),
+    days: int = Query(30, ge=1, le=365),
+    session: Session = Depends(get_session),
+) -> dict:
+    """Paginated run history, projected to the caller's role."""
+    since = datetime.now(timezone.utc) - timedelta(days=days)
+    stmt = select(RunRecord).where(RunRecord.started_at >= since)
+    if environment:
+        stmt = stmt.where(RunRecord.environment == environment)
+    if scenario:
+        stmt = stmt.where(RunRecord.scenario == scenario)
+    stmt = stmt.order_by(RunRecord.started_at.desc())
+    rows = session.execute(stmt).scalars().all()
+    return {"role": role.value, "count": len(rows),
+            "runs": [project(r, role) for r in rows]}
+
+
+@router.get("/trend")   # x-access: read
+def trend(
+    scenario: str = Query(...),
+    environment: str = Query("prod"),
+    metric: str = Query("p95_ms",
+                        pattern="^(p95_ms|p99_ms|error_rate|rps)$"),
+    days: int = Query(90, ge=1, le=365),
+    session: Session = Depends(get_session),
+) -> dict:
+    """Time-series of one metric across runs -- the historical trend view."""
+    since = datetime.now(timezone.utc) - timedelta(days=days)
+    col = getattr(RunRecord, metric)
+    stmt = (select(RunRecord.started_at, col)
+            .where(RunRecord.scenario == scenario,
+                   RunRecord.environment == environment,
+                   RunRecord.started_at >= since)
+            .order_by(RunRecord.started_at.asc()))
+    points = [{"t": t.isoformat(), "value": v}
+              for t, v in session.execute(stmt).all() if v is not None]
+    return {"scenario": scenario, "environment": environment,
+            "metric": metric, "points": points}
+
+
+@router.get("/coverage")   # x-access: read
+def coverage(
+    environment: str = Query("prod"),
+    session: Session = Depends(get_session),
+) -> dict:
+    """Declared flows - tested flows = the 'what needs to complete' list."""
+    inventory = load_inventory()
+    declared = set(inventory.get(environment, []))
+    tested = set(session.execute(
+        select(func.distinct(RunRecord.scenario))
+        .where(RunRecord.environment == environment)
+    ).scalars().all())
+    return {
+        "environment": environment,
+        "declared_flows": sorted(declared),
+        "covered": sorted(tested & declared),
+        "uncovered": sorted(declared - tested),      # still to complete
+        "untracked": sorted(tested - declared),      # run, not declared
+        "coverage_pct": round(
+            100 * len(tested & declared) / max(len(declared), 1), 1),
+    }
