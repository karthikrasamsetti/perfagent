+def test_limits(temp_db):
+    svc = _service(ScriptedProvider(), chat_max_turns=2, chat_max_message_chars=20)
+    with pytest.raises(EmptyMessage):
+        svc.start("   ")
+    with pytest.raises(MessageTooLong):
