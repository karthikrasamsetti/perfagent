+"""Conversational planning — a real back-and-forth that builds the plan.
+
+    service = ChatService(build_provider)
+    view = service.start("Load test login at https://staging.example.com")
+    view = service.send(view["session_id"], "50 users for 2 minutes")
+    view = service.build(view["session_id"])     # -> view["plan"] goes to Review
+
+The conversation is a LangGraph graph checkpointed per session, so it survives a
+refresh or a restart. It only ever drafts a plan — a human still reviews and approves
+it, and nothing here generates a script or fires load.
+"""
+
+from perfagent.chat.draft import ChatTurn, Readiness, assess, merge_intent
+from perfagent.chat.graph import ChatState, build_chat_graph
+from perfagent.chat.service import (
+    ChatError,
+    ChatService,
+    EmptyMessage,
+    MessageTooLong,
+    NotReady,
+    ProviderUnavailable,
+    SessionNotFound,
+    TurnLimitReached,
+    make_checkpointer,
+)
+
+__all__ = [
+    "ChatService", "ChatState", "ChatTurn", "Readiness", "assess", "merge_intent",
+    "build_chat_graph", "make_checkpointer",
+    "ChatError", "EmptyMessage", "MessageTooLong", "NotReady", "ProviderUnavailable",
+    "SessionNotFound", "TurnLimitReached",
+]
diff --git a/src/perfagent/chat/draft.py b/src/perfagent/chat/draft.py
new file mode 100644
index 0000000..6682320
--- /dev/null
+++ b/src/perfagent/chat/draft.py
@@ -0,0 +1,175 @@
+"""The conversation's structured draft — what the chat is actually building.
+
+The chat text is not the source of truth; this draft is. Each turn the model returns a
+ChatTurn (a short reply + the full updated draft). Code then:
+
+  - merges it into the previous draft (``merge_intent``) so a turn can't silently
+    drop something the user said earlier,
+  - decides what is still missing (``assess``) — the model never decides "ready".
+
+The draft reuses ChatIntent from the single-shot describe step, so both paths feed
+the same planner.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+from urllib.parse import urlsplit
+
+from pydantic import BaseModel, Field
+
+from perfagent.chat_intent import ChatEndpoint, ChatIntent
+from perfagent.contracts.load_model import LoadProfileType
+
+# Used when the user never states a size — the same defaults as the single-shot path.
+DEFAULT_USERS = 20
+DEFAULT_DURATION_SECONDS = 60
+
+_REDACTION_MARK = "_REDACTED>"
+
+
+class ChatTurn(BaseModel):
+    """What the model returns for one conversation turn. Schema-validated."""
+
+    reply: str = Field(
+        default="",
+        description="A short, friendly reply to the user (1-3 sentences). Confirm what "
+                    "you understood or changed. If something essential is missing, ask "
+                    "for it here — at most two questions per turn.",
+    )
+    intent: ChatIntent = Field(
+        default_factory=ChatIntent,
+        description="The FULL updated draft after this turn: carry over everything from "
+                    "the current draft that the user did not change.",
+    )
+    wants_plan: bool = Field(
+        default=False,
+        description="True only if the user's latest message asks to go ahead and build "
+                    "the plan now (e.g. 'looks good', 'go ahead', 'build it').",
+    )
+
+
+@dataclass
+class Readiness:
+    """Code's verdict on whether the draft is enough to build a plan."""
+
+    missing: list[str] = field(default_factory=list)     # machine keys: target | endpoints
+    prompts: list[str] = field(default_factory=list)     # the matching questions
+    assumed: dict[str, bool] = field(default_factory=dict)  # sizes the user never stated
+
+    @property
+    def ready(self) -> bool:
+        return not self.missing
+
+
+# ---------- normalisation ----------
+
+def _normalise_base_url(url: str) -> str:
+    url = (url or "").strip().rstrip("/")
+    if not url:
+        return ""
+    if not (url.startswith("http://") or url.startswith("https://")):
+        return ""            # not usable as a target — treated as still missing
+    return url
+
+
+def _normalise_path(path: str, base_url: str = "") -> str:
+    """Make a path the planner accepts: starts with '/', no host."""
+    path = (path or "").strip()
+    if path.startswith("http://") or path.startswith("https://"):
+        parts = urlsplit(path)
+        path = parts.path or "/"
+        if parts.query:
+            path += "?" + parts.query
+    if not path.startswith("/"):
+        path = "/" + path
+    return path
+
+
+def _normalise_endpoints(endpoints: list[ChatEndpoint], base_url: str) -> list[ChatEndpoint]:
+    """Clean paths and drop exact duplicates (same method + path), keeping the first."""
+    out: list[ChatEndpoint] = []
+    seen: set[tuple[str, str]] = set()
+    for ep in endpoints:
+        path = _normalise_path(ep.path, base_url)
+        key = (ep.method.value, path)
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append(ChatEndpoint(method=ep.method, path=path, example_body=ep.example_body))
+    return out
+
+
+# ---------- merge ----------
+
+def merge_intent(previous: ChatIntent, new: ChatIntent) -> ChatIntent:
+    """Fold this turn's draft into the previous one — deterministically.
+
+    "Not stated" values in the new draft (empty string, 0, empty list) never erase
+    what was already known; anything the model did state wins. The endpoint list is
+    replaced as a whole when the model returns one, so "drop /checkout" works.
+    """
+    target = _normalise_base_url(new.target_base_url) or previous.target_base_url
+    endpoints = new.endpoints if new.endpoints else previous.endpoints
+    return ChatIntent(
+        target_base_url=target,
+        goal=(new.goal or "").strip() or previous.goal,
+        endpoints=_normalise_endpoints(list(endpoints), target),
+        max_users=new.max_users if new.max_users > 0 else previous.max_users,
+        duration_seconds=(new.duration_seconds if new.duration_seconds > 0
+                          else previous.duration_seconds),
+        profile_type=new.profile_type or previous.profile_type or LoadProfileType.RAMP,
+        needs_clarification=[q.strip() for q in new.needs_clarification if q and q.strip()],
+        notes=(new.notes or "").strip(),
+    )
+
+
+# ---------- readiness ----------
+
+def assess(intent: ChatIntent) -> Readiness:
+    """Decide what's still needed before a plan can be built. Code decides, not the AI."""
+    r = Readiness()
+    if not _normalise_base_url(intent.target_base_url):
+        r.missing.append("target")
+        r.prompts.append("What's the target base URL (e.g. https://staging.example.com)?")
+    if not intent.endpoints:
+        r.missing.append("endpoints")
+        r.prompts.append("Which endpoints should I test (method + path)?")
+    r.assumed = {
+        "max_users": intent.max_users <= 0,
+        "duration_seconds": intent.duration_seconds <= 0,
+    }
+    return r
+
+
+def has_masked_values(intent: ChatIntent) -> bool:
+    """True if a request body still carries a guardrail placeholder (a masked secret)."""
+    for ep in intent.endpoints:
+        if ep.example_body and _REDACTION_MARK in json.dumps(ep.example_body):
+            return True
+    return False
+
+
+def draft_view(intent: ChatIntent, readiness: Readiness) -> dict:
+    """The draft as the UI shows it, with the defaults that will apply filled in."""
+    return {
+        "target_base_url": intent.target_base_url,
+        "goal": intent.goal,
+        "profile_type": intent.profile_type.value,
+        "max_users": intent.max_users or DEFAULT_USERS,
+        "duration_seconds": intent.duration_seconds or DEFAULT_DURATION_SECONDS,
+        "assumed": readiness.assumed,
+        "endpoints": [
+            {"method": e.method.value, "path": e.path, "example_body": e.example_body}
+            for e in intent.endpoints
+        ],
+        "notes": intent.notes,
+        "secrets_masked": has_masked_values(intent),
+    }
+
+
+__all__ = [
+    "ChatTurn", "Readiness", "merge_intent", "assess", "draft_view", "has_masked_values",
+    "DEFAULT_USERS", "DEFAULT_DURATION_SECONDS",
+]
diff --git a/src/perfagent/chat/graph.py b/src/perfagent/chat/graph.py
new file mode 100644
index 0000000..8b4f840
--- /dev/null
+++ b/src/perfagent/chat/graph.py
@@ -0,0 +1,281 @@
+"""The conversation graph (LangGraph).
+
+    START -> understand -> await_user  <-----------+
+                 |             |                   |
+                 |             +-- message ---> understand
+                 |             +-- build -----> build_plan --> await_user
+                 +-- ready and the user said "go ahead" --> build_plan
+
+  understand  one guarded LLM call returns a ChatTurn; code merges it into the draft
+              and decides what is still missing.
+  await_user  a LangGraph ``interrupt`` — the graph is checkpointed and stops here
+              until the user sends a message or presses "Build plan". This is the same
+              mechanism the approval gate will use when the run steps join the graph.
+  build_plan  hands the draft to the normal planner and saves the plan for review.
+
+The graph never generates a script and never fires load. Failures inside a node are
+turned into an assistant message and the conversation carries on, so one bad LLM call
+never strands a session.
+"""
+
+from __future__ import annotations
+
+import operator
+import time
+from collections.abc import Callable
+from datetime import datetime, timezone
+from typing import Annotated, Any, TypedDict
+
+from langchain_core.runnables import RunnableConfig
+from langgraph.graph import START, StateGraph
+from langgraph.types import Command, interrupt
+
+from perfagent import audit, tracing
+from perfagent.chat.draft import ChatTurn, assess, merge_intent
+from perfagent.chat.planning import build_plan_from_intent
+from perfagent.chat.prompts import CONVERSATION_SYSTEM_PROMPT, build_turn_prompt
+from perfagent.chat_intent import ChatIntent
+from perfagent.logging_config import get_logger
+from perfagent.plan_summary import usage_summary
+from perfagent.providers.base import LLMProvider
+
+_log = get_logger("perfagent.chat")
+
+ProviderFactory = Callable[[], LLMProvider]
+
+
+class ChatState(TypedDict, total=False):
+    """Everything a conversation remembers. Plain JSON types only (checkpointed)."""
+
+    messages: Annotated[list[dict], operator.add]  # {role, content, kind, ts}
+    intent: dict               # the structured draft (ChatIntent as JSON)
+    missing: list[str]         # essentials code says are still missing
+    questions: list[str]       # what to ask next (code's prompts + the model's)
+    ready: bool                # enough to build a plan
+    wants_plan: bool           # the user asked to go ahead this turn
+    plan: dict | None          # the last plan built from this conversation
+    plan_current: bool         # False once the draft changed after that plan
+    redactions: dict           # cumulative guardrail counts for this conversation
+    usage: dict                # token usage of the last AI call
+    tokens_total: int          # tokens used by this conversation so far
+    turns: int                 # user turns so far
+    pending_collection: str    # a pasted collection, for the next turn only
+    last_error: str            # set when the last AI step failed
+
+
+def message(role: str, content: str, kind: str = "text") -> dict:
+    """One transcript entry."""
+    return {
+        "role": role,
+        "content": content,
+        "kind": kind,
+        "ts": datetime.now(timezone.utc).isoformat(),
+    }
+
+
+def _thread_id(config: RunnableConfig | None) -> str:
+    return str(((config or {}).get("configurable") or {}).get("thread_id", ""))
+
+
+def _intent_of(state: ChatState) -> ChatIntent:
+    return ChatIntent.model_validate(state.get("intent") or {})
+
+
+def _core(intent: ChatIntent) -> dict:
+    """The part of the draft that changes the plan (ignores notes/questions)."""
+    return intent.model_dump(mode="json", exclude={"needs_clarification", "notes"})
+
+
+def _fallback_reply(ready: bool, prompts: list[str]) -> str:
+    if ready:
+        return "I have what I need. Tell me what to change, or build the plan."
+    return "I still need a couple of things: " + " ".join(prompts)
+
+
+def build_chat_graph(
+    provider_factory: ProviderFactory,
+    checkpointer: Any,
+    *,
+    history_window: int = 12,
+    llm_attempts: int = 2,
+    retry_delay_seconds: float = 0.5,
+):
+    """Compile the conversation graph.
+
+    ``provider_factory`` is called inside the nodes (never stored in state), so the
+    provider stays out of the checkpoint and tests can swap it freely.
+    """
+
+    def _structured_with_retry(provider: LLMProvider, user_prompt: str) -> ChatTurn:
+        last: Exception | None = None
+        for attempt in range(1, max(1, llm_attempts) + 1):
+            try:
+                return provider.structured(
+                    response_model=ChatTurn,
+                    system=CONVERSATION_SYSTEM_PROMPT,
+                    user=user_prompt,
+                )
+            except Exception as e:  # noqa: BLE001 — any provider failure is retryable once
+                last = e
+                _log.warning("chat.llm_failed", attempt=attempt, error=f"{type(e).__name__}: {e}")
+                if attempt < llm_attempts and retry_delay_seconds > 0:
+                    time.sleep(retry_delay_seconds * attempt)
+        assert last is not None
+        raise last
+
+    # ---- nodes ----------------------------------------------------------------
+
+    def understand(state: ChatState, config: RunnableConfig) -> dict:
+        """Read the latest user message and update the draft."""
+        messages = state.get("messages") or []
+        latest = messages[-1]["content"] if messages else ""
+        history = messages[:-1][-history_window:]
+        previous = _intent_of(state)
+        was = assess(previous)
+
+        tracing.set_step("chat")
+        try:
+            provider = provider_factory()
+            turn = _structured_with_retry(provider, build_turn_prompt(
+                intent=previous,
+                missing=was.missing,
+                history=[m for m in history if m.get("kind") != "error"],
+                message=latest,
+                collection_text=state.get("pending_collection") or "",
+            ))
+        except Exception as e:  # noqa: BLE001
+            return {
+                "messages": [message(
+                    "assistant",
+                    "I couldn't reach the AI just now, so nothing changed. "
+                    "Send your message again in a moment.",
+                    kind="error",
+                )],
+                "last_error": f"{type(e).__name__}: {e}"[:500],
+                "wants_plan": False,
+                "pending_collection": "",
+            }
+
+        merged = merge_intent(previous, turn.intent)
+        now = assess(merged)
+        questions = now.prompts + [q for q in merged.needs_clarification
+                                   if q not in now.prompts]
+        reply = (turn.reply or "").strip() or _fallback_reply(now.ready, now.prompts)
+
+        usage = usage_summary(provider)
+        tokens = int(usage.get("total_tokens", 0) or 0)
+        audit.record(
+            "chat.turn", entity="chat", entity_id=_thread_id(config)[:32],
+            target=merged.target_base_url,
+            summary=f"Conversation turn {state.get('turns', 0)}",
+            tokens=tokens, cost_usd=float(usage.get("cost_usd", 0.0) or 0.0),
+        )
+
+        changed = _core(merged) != _core(previous)
+        update: dict = {
+            "messages": [message("assistant", reply)],
+            "intent": merged.model_dump(mode="json"),
+            "missing": now.missing,
+            "questions": questions,
+            "ready": now.ready,
+            "wants_plan": bool(turn.wants_plan),
+            "usage": usage,
+            "tokens_total": int(state.get("tokens_total", 0)) + tokens,
+            "pending_collection": "",
+            "last_error": "",
+        }
+        if changed and state.get("plan"):
+            update["plan_current"] = False
+        return update
+
+    def route_after_understand(state: ChatState) -> str:
+        if state.get("ready") and state.get("wants_plan") and not state.get("last_error"):
+            return "build_plan"
+        return "await_user"
+
+    def await_user(state: ChatState) -> Command:
+        """Stop and wait. Resumed with {'type': 'message'|'build', ...}."""
+        cmd = interrupt({"waiting_for": "user", "ready": bool(state.get("ready"))})
+        kind = (cmd or {}).get("type")
+
+        if kind == "build":
+            if state.get("ready"):
+                return Command(goto="build_plan")
+            # Fail closed: never build from an incomplete draft, whoever asked.
+            prompts = assess(_intent_of(state)).prompts
+            return Command(goto="await_user", update={
+                "messages": [message("assistant", _fallback_reply(False, prompts))],
+            })
+
+        # a new user message
+        counts = dict(state.get("redactions") or {})
+        for k, v in ((cmd or {}).get("redactions") or {}).items():
+            counts[k] = counts.get(k, 0) + int(v)
+        entries = [message("user", str((cmd or {}).get("text", "")))]
+        collection = str((cmd or {}).get("collection_text", "") or "")
+        if collection:
+            entries.append(message(
+                "user", f"Attached an API collection ({len(collection):,} characters).",
+                kind="attachment"))
+        return Command(goto="understand", update={
+            "messages": entries,
+            "pending_collection": collection,
+            "turns": int(state.get("turns", 0)) + 1,
+            "redactions": counts,
+        })
+
+    def build_plan(state: ChatState, config: RunnableConfig) -> dict:
+        """Hand the draft to the planner and save the plan for review."""
+        intent = _intent_of(state)
+        first_user = next((m["content"] for m in state.get("messages") or []
+                           if m.get("role") == "user"), "")
+        try:
+            provider = provider_factory()
+            plan = build_plan_from_intent(
+                intent, provider,
+                session_id=_thread_id(config), fallback_goal=first_user,
+            )
+        except Exception as e:  # noqa: BLE001
+            _log.warning("chat.build_failed", error=f"{type(e).__name__}: {e}")
+            return {
+                "messages": [message(
+                    "assistant",
+                    "I couldn't draft the plan just now. Your draft is safe — "
+                    "try Build plan again in a moment.",
+                    kind="error",
+                )],
+                "last_error": f"{type(e).__name__}: {e}"[:500],
+                "wants_plan": False,
+            }
+
+        scenarios = len(plan["load_model"].get("scenarios") or [])
+        tokens = int((plan.get("usage") or {}).get("total_tokens", 0) or 0)
+        return {
+            "messages": [message(
+                "assistant",
+                f"Plan drafted with {scenarios} scenario{'s' if scenarios != 1 else ''}. "
+                "Review and approve it on the next step — nothing runs until you do.",
+                kind="plan",
+            )],
+            "plan": plan,
+            "plan_current": True,
+            "wants_plan": False,
+            "usage": plan.get("usage") or {},
+            "tokens_total": int(state.get("tokens_total", 0)) + tokens,
+            "last_error": "",
+        }
+
+    # ---- wiring ---------------------------------------------------------------
+
+    g = StateGraph(ChatState)
+    g.add_node("understand", understand)
+    g.add_node("await_user", await_user, destinations=("understand", "build_plan", "await_user"))
+    g.add_node("build_plan", build_plan)
+    g.add_edge(START, "understand")
+    g.add_conditional_edges("understand", route_after_understand,
+                            {"build_plan": "build_plan", "await_user": "await_user"})
+    g.add_edge("build_plan", "await_user")
+    return g.compile(checkpointer=checkpointer)
+
+
+__all__ = ["ChatState", "build_chat_graph", "message"]
diff --git a/src/perfagent/chat/planning.py b/src/perfagent/chat/planning.py
new file mode 100644
index 0000000..1ac3b9b
--- /dev/null
+++ b/src/perfagent/chat/planning.py
@@ -0,0 +1,82 @@
+"""Turn the conversation's draft into a saved plan — through the normal planner.
+
+This is the hand-off from chat to the rest of the agent. It reuses ``draft_plan`` (so
+every deterministic control still applies: forced target, code-owned load shape,
+threshold sanity, correlation), stores the plan, audits it and grades it. The result
+has the same shape the Review step already consumes from /api/plan and /api/chat-plan.
+
+Nothing here fires load: the plan still has to be reviewed and approved by a human.
+"""
+
+from __future__ import annotations
+
+from perfagent import audit, tracing
+from perfagent.chat.draft import DEFAULT_DURATION_SECONDS, DEFAULT_USERS
+from perfagent.chat_intent import ChatIntent
+from perfagent.db import PlanRow, get_session
+from perfagent.evaluation import evaluate_plan
+from perfagent.plan_summary import plan_rationale, usage_summary
+from perfagent.planner import PlanRequest, draft_plan
+from perfagent.planner.spec import EndpointSpec
+from perfagent.providers.base import LLMProvider
+
+
+def plan_request_from_intent(intent: ChatIntent, fallback_goal: str = "") -> PlanRequest:
+    """Map the draft onto the planner's input. Raises ValueError if it isn't usable."""
+    return PlanRequest(
+        target_base_url=intent.target_base_url,
+        goal=intent.goal or fallback_goal[:120],
+        max_users=intent.max_users or DEFAULT_USERS,
+        duration_seconds=intent.duration_seconds or DEFAULT_DURATION_SECONDS,
+        profile_type=intent.profile_type,
+        endpoints=[
+            EndpointSpec(method=e.method, path=e.path, example_body=e.example_body)
+            for e in intent.endpoints
+        ],
+    )
+
+
+def build_plan_from_intent(
+    intent: ChatIntent,
+    provider: LLMProvider,
+    *,
+    session_id: str = "",
+    fallback_goal: str = "",
+) -> dict:
+    """Draft, save, audit and evaluate a plan. Returns the Review-step payload."""
+    request = plan_request_from_intent(intent, fallback_goal)
+
+    tracing.set_step("chat")
+    plan = draft_plan(request, provider)
+
+    with get_session() as s:
+        s.add(PlanRow(
+            id=plan.id,
+            target_base_url=plan.load_model.target_base_url,
+            goal=request.goal,
+            load_model_json=plan.load_model.model_dump_json(),
+        ))
+        s.commit()
+
+    usage = usage_summary(provider)
+    audit.record(
+        "plan.created", entity="plan", entity_id=plan.id,
+        target=plan.load_model.target_base_url,
+        summary=(f"Conversation-drafted a plan with "
+                 f"{len(plan.load_model.scenarios)} scenario(s)"),
+        tokens=usage.get("total_tokens", 0), cost_usd=usage.get("cost_usd", 0.0),
+    )
+
+    return {
+        "plan_id": plan.id,
+        "provider": getattr(provider, "name", ""),
+        "load_model": plan.load_model.model_dump(mode="json"),
+        "evaluation": evaluate_plan(plan.load_model, request).summary(),
+        "rationale": plan_rationale(plan.load_model),
+        "usage": usage,
+        "notes": intent.notes,
+        "session_id": session_id,
+    }
+
+
+__all__ = ["plan_request_from_intent", "build_plan_from_intent"]
diff --git a/src/perfagent/chat/prompts.py b/src/perfagent/chat/prompts.py
new file mode 100644
index 0000000..665bb6d
--- /dev/null
+++ b/src/perfagent/chat/prompts.py
@@ -0,0 +1,110 @@
+"""Prompts for the conversational planner.
+
+Each turn the model gets: the current structured draft, what code says is still
+missing, the recent messages, and the latest user message. It returns a ChatTurn.
+Because the draft carries the conversation's state, only a short window of messages
+is replayed — long chats don't grow the prompt.
+"""
+
+from __future__ import annotations
+
+import json
+
+from perfagent.chat_intent import ChatIntent
+
+# Pasted collections are bounded: the model needs the structure, not every byte.
+MAX_COLLECTION_CHARS = 8000
+
+CONVERSATION_SYSTEM_PROMPT = """\
+You are the planning assistant of a performance-testing agent. You hold a short \
+conversation with the user to work out WHAT to load test, and you keep a structured \
+draft up to date. You never run anything — a human reviews and approves the plan later.
+
+Each turn you receive the current draft, the list of essentials still missing, the \
+recent conversation, and the user's latest message. Return:
+- intent: the FULL updated draft. Start from the current draft and apply only what \
+the latest message changes. Never drop endpoints, the target, or sizes the user did \
+not ask to change. If the user asks to remove an endpoint, return the list without it.
+- reply: 1-3 friendly sentences. Say what you understood or changed. If essentials \
+are missing, ask for them — at most two questions per turn, the most important first.
+- wants_plan: true only when the latest message clearly asks to go ahead and build \
+the plan ("looks good", "go ahead", "build it", "yes, create the plan").
+
+What goes in the draft:
+- target_base_url: scheme + host (+ port) only, e.g. https://staging.example.com.
+- endpoints: method, path (starting with /), and an example body where relevant. \
+Only use endpoints the user gave or that appear in a pasted collection. Never invent paths.
+- max_users and duration_seconds: only if the user stated them, otherwise 0. Convert \
+"2 minutes" to 120.
+- profile_type: ramp (default), spike, soak, or stress.
+- goal: a one-line restatement of what is being tested.
+- needs_clarification: open questions that would improve the test but do not block it.
+- notes: a short note on assumptions you made.
+
+DYNAMIC DATA:
+When the user says a field should be unique, random, or generated, set that body \
+field's value to the matching generator token:
+  ${uuid}                -> a unique id
+  ${randomEmail}         -> a unique email
+  ${randomInt(min,max)}  -> a random integer
+  ${randomString(n)}     -> a random string of length n
+  ${timestamp}           -> current time
+  ${randomFrom(a,b,c)}   -> a random choice
+Leave fixed values alone. Values shown as <..._REDACTED> were masked for safety: keep \
+them exactly as they are and never guess what they were. Do not invent passwords or tokens.
+
+Do not ask for information that is already in the draft. Do not ask about the load \
+ramp shape, thresholds or correlation — those are handled after the plan is drafted. \
+Return only the structured result.\
+"""
+
+_MISSING_LABELS = {
+    "target": "the target base URL",
+    "endpoints": "at least one endpoint (method + path)",
+}
+
+
+def _draft_json(intent: ChatIntent) -> str:
+    data = intent.model_dump(mode="json", exclude={"needs_clarification", "notes"})
+    return json.dumps(data, indent=2)
+
+
+def build_turn_prompt(
+    *,
+    intent: ChatIntent,
+    missing: list[str],
+    history: list[dict],
+    message: str,
+    collection_text: str = "",
+) -> str:
+    """Build the user prompt for one turn.
+
+    ``history`` is the recent transcript *before* the latest message, oldest first.
+    """
+    parts: list[str] = []
+    parts.append("Current draft (JSON):\n" + _draft_json(intent))
+
+    if missing:
+        labels = ", ".join(_MISSING_LABELS.get(m, m) for m in missing)
+        parts.append(f"Essentials still missing before a plan can be built: {labels}.")
+    else:
+        parts.append("All essentials are present — a plan can be built whenever the "
+                     "user is happy with the draft.")
+
+    if history:
+        lines = [f"{m.get('role', 'user')}: {m.get('content', '')}" for m in history]
+        parts.append("Recent conversation (oldest first):\n" + "\n".join(lines))
+
+    parts.append("Latest user message:\n" + message)
+
+    if collection_text.strip():
+        parts.append(
+            "Pasted API collection (OpenAPI/Postman/HAR or similar) — take endpoints "
+            "from it:\n" + collection_text[:MAX_COLLECTION_CHARS]
+        )
+
+    parts.append("Return the full updated draft, a short reply, and wants_plan.")
+    return "\n\n".join(parts)
+
+
+__all__ = ["CONVERSATION_SYSTEM_PROMPT", "MAX_COLLECTION_CHARS", "build_turn_prompt"]
diff --git a/src/perfagent/chat/service.py b/src/perfagent/chat/service.py
new file mode 100644
index 0000000..f10fa14
--- /dev/null
+++ b/src/perfagent/chat/service.py
@@ -0,0 +1,345 @@
+"""ChatService — the conversation's application layer.
+
+Owns the compiled graph and its checkpointer, and exposes the five things the API
+needs: start, send, build, get, list (+ delete). It also:
+
+  - masks one-way secrets in every incoming message BEFORE it enters the graph, so
+    passwords/tokens/emails typed into the chat are never checkpointed to disk
+    (hosts are kept readable here; the guarded provider masks them again per call);
+  - enforces message-size and turn limits;
+  - serialises work per conversation, so two requests can't interleave on one thread;
+  - keeps a small index row (ChatSessionRow) for the "recent conversations" list.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+import threading
+import uuid
+from collections.abc import Callable
+from typing import Any
+
+from langgraph.checkpoint.memory import InMemorySaver
+from langgraph.types import Command
+
+from perfagent.chat.draft import assess, draft_view
+from perfagent.chat.graph import build_chat_graph, message
+from perfagent.chat.prompts import MAX_COLLECTION_CHARS
+from perfagent.chat_intent import ChatIntent
+from perfagent.config import Settings, get_settings
+from perfagent.db import ChatSessionRow, get_session
+from perfagent.guardrails.redaction import redact, restore
+from perfagent.logging_config import get_logger
+from perfagent.plan_summary import summarize_redactions
+from perfagent.providers.base import LLMProvider
+
+_log = get_logger("perfagent.chat")
+
+
+# ---------- errors (mapped to HTTP status codes by the routes) ----------
+
+class ChatError(Exception):
+    """Base class for conversation errors."""
+
+
+class EmptyMessage(ChatError):
+    pass
+
+
+class MessageTooLong(ChatError):
+    pass
+
+
+class SessionNotFound(ChatError):
+    pass
+
+
+class NotReady(ChatError):
+    """Build was requested but essentials are still missing."""
+
+    def __init__(self, prompts: list[str]):
+        super().__init__("the draft is missing essentials: " + " ".join(prompts))
+        self.prompts = prompts
+
+
+class TurnLimitReached(ChatError):
+    pass
+
+
+class ProviderUnavailable(ChatError):
+    """The LLM provider is not configured (e.g. no API key)."""
+
+
+# ---------- checkpointer ----------
+
+def make_checkpointer(path: str) -> tuple[Any, Callable[[], None]]:
+    """Build the checkpoint store. Returns (saver, close).
+
+    ":memory:" (or empty) keeps conversations in memory only. Anything else is a
+    SQLite file, so conversations survive a restart. Swapping to Postgres later is
+    a change here only (langgraph-checkpoint-postgres' PostgresSaver).
+    """
+    if not path or path == ":memory:":
+        return InMemorySaver(), (lambda: None)
+
+    from langgraph.checkpoint.sqlite import SqliteSaver
+
+    conn = sqlite3.connect(path, check_same_thread=False)
+    saver = SqliteSaver(conn)
+    saver.setup()
+    return saver, conn.close
+
+
+# ---------- service ----------
+
+class ChatService:
+    def __init__(
+        self,
+        provider_factory: Callable[[], LLMProvider],
+        *,
+        settings: Settings | None = None,
+        checkpointer: Any | None = None,
+        retry_delay_seconds: float = 0.5,
+    ) -> None:
+        self._settings = settings or get_settings()
+        self._provider_factory = provider_factory
+        if checkpointer is None:
+            checkpointer, self._close = make_checkpointer(self._settings.chat_checkpoint_db)
+        else:
+            self._close = lambda: None
+        self._checkpointer = checkpointer
+        self._graph = build_chat_graph(
+            provider_factory,
+            checkpointer,
+            history_window=self._settings.chat_history_window,
+            retry_delay_seconds=retry_delay_seconds,
+        )
+        self._locks: dict[str, threading.Lock] = {}
+        self._locks_guard = threading.Lock()
+
+    # ---- public API -----------------------------------------------------------
+
+    def start(self, text: str, collection_text: str = "") -> dict:
+        """Open a conversation with its first message and run the first turn."""
+        clean, collection, counts = self._ingest(text, collection_text)
+        self._require_provider()
+
+        session_id = uuid.uuid4().hex
+        with get_session() as s:
+            s.add(ChatSessionRow(id=session_id, title=clean[:80], turns=1))
+            s.commit()
+
+        entries = [message("user", clean)]
+        if collection:
+            entries.append(message(
+                "user", f"Attached an API collection ({len(collection):,} characters).",
+                kind="attachment"))
+        with self._lock(session_id):
+            try:
+                self._graph.invoke(
+                    {"messages": entries, "pending_collection": collection,
+                     "turns": 1, "redactions": counts},
+                    self._config(session_id),
+                )
+            except Exception:
+                # Don't leave an index row pointing at a conversation that never started.
+                with get_session() as s:
+                    row = s.get(ChatSessionRow, session_id)
+                    if row is not None:
+                        s.delete(row)
+                        s.commit()
+                raise
+            return self._finish(session_id)
+
+    def send(self, session_id: str, text: str, collection_text: str = "") -> dict:
+        """Add a user message to an existing conversation and run the turn."""
+        clean, collection, counts = self._ingest(text, collection_text)
+        with self._lock(session_id):
+            state = self._state(session_id)
+            if int(state.get("turns", 0)) >= self._settings.chat_max_turns:
+                raise TurnLimitReached(
+                    f"this conversation reached its limit of "
+                    f"{self._settings.chat_max_turns} turns — build the plan or start "
+                    "a new conversation")
+            self._require_provider()
+            self._settle(session_id)
+            self._graph.invoke(
+                Command(resume={"type": "message", "text": clean,
+                                "collection_text": collection, "redactions": counts}),
+                self._config(session_id),
+            )
+            return self._finish(session_id)
+
+    def build(self, session_id: str) -> dict:
+        """Build a plan from the draft. Refuses if essentials are missing."""
+        with self._lock(session_id):
+            state = self._state(session_id)
+            readiness = assess(ChatIntent.model_validate(state.get("intent") or {}))
+            if not readiness.ready:
+                raise NotReady(readiness.prompts)
+            self._require_provider()
+            self._settle(session_id)
+            self._graph.invoke(Command(resume={"type": "build"}), self._config(session_id))
+            return self._finish(session_id)
+
+    def get(self, session_id: str) -> dict:
+        """The conversation as the UI shows it (used to resume after a refresh)."""
+        return self._view(session_id, self._state(session_id))
+
+    def list(self, limit: int = 20) -> list[dict]:
+        """Recent conversations, newest first."""
+        with get_session() as s:
+            rows = (s.query(ChatSessionRow)
+                    .order_by(ChatSessionRow.updated_at.desc())
+                    .limit(max(1, min(limit, 100))).all())
+            return [
+                {
+                    "session_id": r.id,
+                    "title": r.title,
+                    "status": r.status,
+                    "turns": r.turns,
+                    "plan_id": r.plan_id,
+                    "created_at": r.created_at.isoformat(),
+                    "updated_at": r.updated_at.isoformat(),
+                }
+                for r in rows
+            ]
+
+    def delete(self, session_id: str) -> None:
+        """Forget a conversation: its checkpoints and its index row."""
+        with self._lock(session_id):
+            with get_session() as s:
+                row = s.get(ChatSessionRow, session_id)
+                if row is None:
+                    raise SessionNotFound(session_id)
+                s.delete(row)
+                s.commit()
+            try:
+                self._checkpointer.delete_thread(session_id)
+            except Exception as e:  # noqa: BLE001 — the index row is gone; log and move on
+                _log.warning("chat.checkpoint_delete_failed", error=str(e))
+        with self._locks_guard:
+            self._locks.pop(session_id, None)
+
+    def close(self) -> None:
+        """Release the checkpoint store (closes the SQLite connection)."""
+        try:
+            self._close()
+        except Exception:  # noqa: BLE001
+            pass
+
+    # ---- internals ------------------------------------------------------------
+
+    def _ingest(self, text: str, collection_text: str) -> tuple[str, str, dict[str, int]]:
+        """Validate a message and mask its one-way secrets before it is stored.
+
+        Hosts are restored so the transcript stays readable; the guarded provider
+        masks them again on every LLM call. Returns (message, collection, counts).
+        """
+        text = (text or "").strip()
+        if not text:
+            raise EmptyMessage("message is empty")
+        if len(text) > self._settings.chat_max_message_chars:
+            raise MessageTooLong(
+                f"message is too long (max {self._settings.chat_max_message_chars:,} "
+                "characters)")
+
+        counts: dict[str, int] = {}
+
+        def _mask(raw: str) -> str:
+            r = redact(raw)
+            for k, v in r.counts.items():
+                counts[k] = counts.get(k, 0) + v
+            return restore(r.text, r.mapping)
+
+        clean = _mask(text)
+        collection = (collection_text or "").strip()[:MAX_COLLECTION_CHARS]
+        collection = _mask(collection) if collection else ""
+        return clean, collection, counts
+
+    def _require_provider(self) -> None:
+        try:
+            self._provider_factory()
+        except ValueError as e:
+            raise ProviderUnavailable(str(e)) from e
+
+    def _lock(self, session_id: str) -> threading.Lock:
+        with self._locks_guard:
+            return self._locks.setdefault(session_id, threading.Lock())
+
+    @staticmethod
+    def _config(session_id: str) -> dict:
+        return {"configurable": {"thread_id": session_id}}
+
+    def _state(self, session_id: str) -> dict:
+        values = self._graph.get_state(self._config(session_id)).values
+        if not values:
+            raise SessionNotFound(session_id)
+        return values
+
+    def _settle(self, session_id: str) -> None:
+        """Make sure the graph is parked at the wait point before resuming it.
+
+        Normally it always is. If the process died in the middle of a step, the
+        checkpoint still has that step pending — run it to the wait point first, so
+        the resume below is delivered to ``await_user`` and nothing is skipped.
+        """
+        config = self._config(session_id)
+        snapshot = self._graph.get_state(config)
+        if snapshot.next and not snapshot.interrupts:
+            _log.info("chat.recovering_pending_step", session_id=session_id,
+                      pending=list(snapshot.next))
+            self._graph.invoke(None, config)
+
+    def _finish(self, session_id: str) -> dict:
+        """After a graph step: refresh the index row and return the view."""
+        state = self._state(session_id)
+        view = self._view(session_id, state)
+        with get_session() as s:
+            row = s.get(ChatSessionRow, session_id)
+            if row is not None:
+                row.status = view["status"]
+                row.turns = int(state.get("turns", 0))
+                row.plan_id = (state.get("plan") or {}).get("plan_id", "") or ""
+                if not row.title and view["draft"]["goal"]:
+                    row.title = view["draft"]["goal"][:80]
+                s.commit()
+        return view
+
+    def _view(self, session_id: str, state: dict) -> dict:
+        intent = ChatIntent.model_validate(state.get("intent") or {})
+        readiness = assess(intent)
+        plan = state.get("plan")
+        plan_current = bool(plan) and bool(state.get("plan_current"))
+        if plan_current:
+            status = "planned"
+        elif readiness.ready:
+            status = "ready"
+        else:
+            status = "collecting"
+
+        guardrail = summarize_redactions(state.get("redactions") or {})
+        turns = int(state.get("turns", 0))
+        return {
+            "session_id": session_id,
+            "status": status,
+            "ready": readiness.ready,
+            "messages": state.get("messages") or [],
+            "draft": draft_view(intent, readiness),
+            "missing": readiness.missing,
+            "questions": state.get("questions") or readiness.prompts,
+            "plan": ({**plan, "guardrail": guardrail} if plan else None),
+            "plan_current": plan_current,
+            "guardrail": guardrail,
+            "usage": state.get("usage") or {},
+            "tokens_total": int(state.get("tokens_total", 0)),
+            "turns": turns,
+            "turns_left": max(0, self._settings.chat_max_turns - turns),
+            "error": state.get("last_error") or "",
+        }
+
+
+__all__ = [
+    "ChatService", "ChatError", "EmptyMessage", "MessageTooLong", "SessionNotFound",
+    "NotReady", "TurnLimitReached", "ProviderUnavailable", "make_checkpointer",
+]
