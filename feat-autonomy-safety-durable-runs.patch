+def test_request_to_a_host_off_the_allow_list_stops_the_run(runner, settings):
+    settings.run_allowed_hosts = "127.0.0.1"
+    # the URL is not written in the script, so only the runtime guard can catch it
+    run = _settle(_start(runner, script(secs=20, urls=["http://127.0.0.1:8000/a",
+                                                       "http://sneaky.example/b"])))
+    assert run.status == "stopped" and "sneaky.example" in run.message
+    assert (run.ended_at - run.started_at) < 10                  # stopped early, not after 20s
+
+
+def test_concurrency_cap(runner, settings):
+    settings.run_max_concurrent = 1
+    first = _start(runner, script(secs=5))
+    with pytest.raises(RunBlocked) as e:
+        _start(runner, script())
+    assert "already in progress" in e.value.reasons[0]
+    runner.stop_run(first.run_id)
+    _settle(first)
+    assert _settle(_start(runner, script())).status == "finished"   # slot is free again
+
