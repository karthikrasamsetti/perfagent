+def test_stop_requested_from_another_process_is_honoured(runner):
+    from perfagent.runner import store
+    run = _start(runner, script(secs=20))
+    _wait_running(run)
+    assert store.request_stop(run.run_id)              # what a different app process would do
+    _settle(run)
+    assert run.status == "stopped"
+    assert not store.request_stop(run.run_id)          # already over
+
