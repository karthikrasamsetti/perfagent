+def _upload(client, content, target="http://127.0.0.1:8000"):
+    r = client.post("/api/scripts/upload", json={"content": content, "target_base_url": target})
+    assert r.status_code == 200
+    return r.json()["script_id"]
+
+
+def _wait_api(client, run_id, timeout=15):
+    end = time.time() + timeout
+    while time.time() < end:
+        j = client.get(f"/api/runs/{run_id}").json()
+        if j["status"] not in ("starting", "preparing", "running"):
+            return j
+        time.sleep(0.05)
+    raise AssertionError("run did not finish")
+
+
+def test_api_safety_state_and_blocked_run(client, settings):
+    st = client.get("/api/safety").json()
+    assert st["policy"]["max_users"] == 1000 and st["kill_switch"]["engaged"] is False
+    assert st["active_runs"] == 0
+
+    settings.run_allowed_hosts = "127.0.0.1"
+    sid = _upload(client, script(), target="http://prod.example.com")
+    r = client.post(f"/api/scripts/{sid}/run")
+    assert r.status_code == 403 and r.json()["detail"].startswith("Blocked by safety limits")
+    assert client.get("/api/runs/active").json()["runs"] == []
+    actions = [e["action"] for e in client.get("/api/audit").json()["events"]]
+    assert "run.blocked" in actions and "run.started" not in actions
+
+
+def test_api_preflight_respects_the_allow_list(client, settings):
+    settings.run_allowed_hosts = "127.0.0.1"
+    body = {"load_model": {
+        "target_base_url": "http://prod.example.com",
+        "scenarios": [{"name": "s", "steps": [{"name": "x", "path": "/"}]}],
+        "load_profile": {"stages": [{"duration_seconds": 1, "target_users": 1}]}}}
+    r = client.post("/api/preflight", json=body)
+    assert r.status_code == 403 and "allow-list" in r.json()["detail"]
+
+
+def test_api_kill_switch_stops_runs_and_is_audited(client):
+    sid = _upload(client, script(secs=20))
+    rid = client.post(f"/api/scripts/{sid}/run").json()["run_id"]
+    end = time.time() + 10
+    while time.time() < end and client.get(f"/api/runs/{rid}").json()["status"] != "running":
+        time.sleep(0.05)
+    assert [r["run_id"] for r in client.get("/api/runs/active").json()["runs"]] == [rid]
+
+    j = client.post("/api/safety/kill-switch", json={"engaged": True, "reason": "drill"}).json()
+    assert j["stopped"] == 1 and j["kill_switch"]["engaged"] is True
+    assert _wait_api(client, rid)["status"] == "stopped"
+    assert client.post(f"/api/scripts/{sid}/run").status_code == 403
+
+    j = client.post("/api/safety/kill-switch", json={"engaged": False}).json()
+    assert j["kill_switch"]["engaged"] is False
+    actions = [e["action"] for e in client.get("/api/audit").json()["events"]]
+    for a in ("safety.kill_switch_on", "run.safety_stop", "safety.kill_switch_off"):
+        assert a in actions
+
