+def test_kill_switch_blocks_new_runs_and_stops_live_ones(runner):
+    run = _start(runner, script(secs=20))
+    _wait_running(run)
+    safety.set_kill_switch(True, "incident")           # only the flag: the heartbeat must act
+    _settle(run)
+    assert run.status == "stopped" and run.message == "Stopped by the kill switch."
+    with pytest.raises(RunBlocked) as e:
+        _start(runner, script())
+    assert "kill switch" in e.value.reasons[0] and "incident" in e.value.reasons[0]
+    safety.set_kill_switch(False)
+    assert _settle(_start(runner, script())).status == "finished"
+
+
+def test_stop_all_runs(runner):
+    a, b = _start(runner, script(secs=20)), _start(runner, script(secs=20))
+    _wait_running(a)
+    _wait_running(b)
+    assert runner.stop_all_runs("Stopped by the kill switch.") == 2
+    _settle(a)
+    _settle(b)
+    assert a.status == b.status == "stopped"
+
