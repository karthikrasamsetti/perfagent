+def test_report_of_a_stopped_run_is_never_a_pass(client):
+    """Fail closed: a run cut short measured only part of the test."""
+    sid = _upload(client, script(secs=20))
+    rid = client.post(f"/api/scripts/{sid}/run").json()["run_id"]
+    end = time.time() + 10
+    while time.time() < end:
+        if client.get(f"/api/runs/{rid}").json()["snapshot"].get("requests"):
+            break
+        time.sleep(0.05)
+    assert client.post(f"/api/runs/{rid}/stop").status_code == 200
+    rep = client.get(f"/api/runs/{rid}/report").json()
+    v = rep["verdict"]
+    assert v["incomplete"] is True and v["overall_passed"] is None
+    assert v["incomplete_reason"] == "Stopped by user"
+    assert all(c["passed"] for c in v["checks"])              # the checks themselves passed
+    assert "inconclusive" in rep["narrative"]["headline"].lower()
+    assert rep["snapshot"]["requests"] > 0
+
