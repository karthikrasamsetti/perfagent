new file mode 100644
index 0000000..5091738
--- /dev/null
+++ b/src/perfagent/safety.py
@@ -0,0 +1,343 @@
+"""Safety rails on load — the active guards in front of every run.
+
+Four rules, all decided in code (never by the AI) and enforced at the lowest level
+(the runner), so the UI, the API and — later — the agent's own orchestration all go
+through the same gate:
+
+  1. Target allow-list   load may only be sent to approved hosts.
+  2. Load caps           a run may not exceed a maximum number of virtual users or a
+                         maximum duration. Both are read from the SCRIPT ITSELF with
+                         `k6 inspect`, not from the plan — scripts can be edited or
+                         uploaded, so the plan is not proof of what will run.
+  3. Concurrency cap     only so many runs at once.
+  4. Kill switch         one durable flag that stops every run in progress and
+                         refuses new ones until it is released.
+
+Fail closed: if a cap is configured and the script's real load cannot be determined,
+the run is refused.
+
+The allow-list scan of a script is a static check of the URLs written in it; the
+runner adds a runtime guard that stops a run the moment a request goes to a host
+that is not allowed (see runner/k6_runner.py).
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import shutil
+import subprocess
+import tempfile
+from dataclasses import dataclass, field
+from pathlib import Path
+from urllib.parse import urlsplit
+
+from perfagent.config import Settings, get_settings
+from perfagent.db import AppStateRow, get_session
+from perfagent.logging_config import get_logger
+
+_log = get_logger("perfagent.safety")
+
+# Slack allowed on top of the duration cap: k6 adds a graceful-stop period (30s by
+# default) after the last stage, which is wind-down, not load.
+DURATION_GRACE_SECONDS = 60
+
+_KILL_SWITCH_KEY = "run_kill_switch"
+
+
+class RunBlocked(Exception):
+    """A run (or pre-flight) was refused by the safety rails."""
+
+    def __init__(self, reasons: list[str]):
+        super().__init__("; ".join(reasons))
+        self.reasons = reasons
+
+
+# ---------- policy ----------
+
+@dataclass(frozen=True)
+class Policy:
+    allowed_hosts: tuple[str, ...] = ()     # empty = any host
+    max_users: int = 0                      # 0 = no cap
+    max_duration_seconds: int = 0           # 0 = no cap
+    max_concurrent: int = 0                 # 0 = no limit
+
+    def to_dict(self) -> dict:
+        return {
+            "allowed_hosts": list(self.allowed_hosts),
+            "max_users": self.max_users,
+            "max_duration_seconds": self.max_duration_seconds,
+            "max_concurrent": self.max_concurrent,
+        }
+
+
+def get_policy(settings: Settings | None = None) -> Policy:
+    s = settings or get_settings()
+    hosts = tuple(h.strip().lower() for h in s.run_allowed_hosts.split(",") if h.strip())
+    return Policy(
+        allowed_hosts=hosts,
+        max_users=s.run_max_users,
+        max_duration_seconds=s.run_max_duration_seconds,
+        max_concurrent=s.run_max_concurrent,
+    )
+
+
+# ---------- hosts ----------
+
+def host_port(url: str) -> tuple[str, str]:
+    """('host', 'port') of a URL, lower-cased; port is '' when not given."""
+    try:
+        parts = urlsplit(url if "://" in url else "//" + url)
+        return (parts.hostname or "").lower(), str(parts.port or "")
+    except ValueError:
+        return "", ""
+
+
+def host_allowed(url: str, allowed: tuple[str, ...] | list[str]) -> bool:
+    """True if the URL's host is on the allow-list (an empty list allows any host).
+
+    An entry may be a host ("staging.example.com"), a host with a port
+    ("127.0.0.1:8000" — that port only) or a wildcard ("*.example.com" — any
+    sub-domain, not the bare domain).
+    """
+    if not allowed:
+        return True
+    host, port = host_port(url)
+    if not host:
+        return False
+    for entry in allowed:
+        entry = entry.strip().lower()
+        if not entry:
+            continue
+        e_host, e_port = entry, ""
+        # split a trailing :port (but leave bare IPv6 alone)
+        if entry.count(":") == 1:
+            e_host, e_port = entry.split(":")
+        if e_port and e_port != port:
+            continue
+        if e_host.startswith("*."):
+            if host.endswith(e_host[1:]):
+                return True
+        elif host == e_host:
+            return True
+    return False
+
+
+_BLOCK_COMMENT = re.compile(r"/\*.*?\*/", re.S)
+_LINE_COMMENT = re.compile(r"^\s*//.*$", re.M)
+_IMPORT_LINE = re.compile(r"^\s*import\b.*$", re.M)
+_URL = re.compile(r"https?://[A-Za-z0-9.\-]+(?::\d+)?", re.I)
+
+
+def script_urls(content: str) -> list[str]:
+    """The distinct http(s) origins written in a script (comments and module
+    imports ignored — an import fetches code, it does not send load)."""
+    text = _BLOCK_COMMENT.sub("", content or "")
+    text = _LINE_COMMENT.sub("", text)
+    text = _IMPORT_LINE.sub("", text)
+    seen: list[str] = []
+    for m in _URL.finditer(text):
+        u = m.group(0).lower()
+        if u not in seen:
+            seen.append(u)
+    return seen
+
+
+def check_target(url: str, policy: Policy | None = None) -> list[str]:
+    """Reasons the target is not allowed (empty list = allowed)."""
+    policy = policy or get_policy()
+    if host_allowed(url, policy.allowed_hosts):
+        return []
+    host, port = host_port(url)
+    shown = f"{host}:{port}" if port else (host or url or "(no target)")
+    return [f"the target host {shown} is not on the allow-list "
+            f"({', '.join(policy.allowed_hosts)})"]
+
+
+# ---------- what a script will really do ----------
+
+@dataclass
+class ScriptLoad:
+    """A script's real load, as k6 itself reports it."""
+
+    max_vus: int | None = None
+    total_seconds: float | None = None
+    error: str = ""
+
+    @property
+    def known(self) -> bool:
+        return self.max_vus is not None and self.total_seconds is not None
+
+
+_DURATION_PART = re.compile(r"(\d+(?:\.\d+)?)(ns|us|µs|ms|h|m|s)")
+_UNIT_SECONDS = {"ns": 1e-9, "us": 1e-6, "µs": 1e-6, "ms": 1e-3, "s": 1.0, "m": 60.0, "h": 3600.0}
+
+
+def parse_duration(text: str) -> float | None:
+    """Seconds in a k6/Go duration such as '1m31s', '2h', '500ms'. None if unparseable."""
+    text = (text or "").strip()
+    if not text:
+        return None
+    if text == "0":
+        return 0.0
+    parts = _DURATION_PART.findall(text)
+    if not parts or "".join(n + u for n, u in parts) != text:
+        return None
+    return sum(float(n) * _UNIT_SECONDS[u] for n, u in parts)
+
+
+def inspect_script_load(content: str, data_filename: str = "", data_content: str = "",
+                        timeout: float = 30.0) -> ScriptLoad:
+    """Ask k6 what the script will do: its peak VUs and total duration. No load is sent.
+
+    Uses `k6 inspect --execution-requirements`, which evaluates the script's options
+    and scenarios without running them.
+    """
+    from perfagent.runner.k6_binary import K6Unavailable, ensure_k6
+
+    try:
+        k6_path = ensure_k6()
+    except K6Unavailable as e:
+        return ScriptLoad(error=f"the load engine is not available: {e}")
+
+    tmpdir = tempfile.mkdtemp(prefix="perfagent_inspect_")
+    try:
+        script = Path(tmpdir) / "loadtest.js"
+        script.write_text(content, encoding="utf-8")
+        if data_filename and data_content:
+            (Path(tmpdir) / data_filename).write_text(data_content, encoding="utf-8")
+        try:
+            proc = subprocess.run(
+                [k6_path, "inspect", "--execution-requirements", str(script)],
+                cwd=tmpdir, capture_output=True, text=True, encoding="utf-8",
+                errors="replace", timeout=timeout,
+            )
+        except subprocess.TimeoutExpired:
+            return ScriptLoad(error=f"inspecting the script timed out after {int(timeout)}s")
+        if proc.returncode != 0:
+            tail = (proc.stderr or proc.stdout or "").strip()[-300:]
+            return ScriptLoad(error=f"the script could not be inspected: {tail}")
+        try:
+            data = json.loads(proc.stdout)
+        except json.JSONDecodeError:
+            return ScriptLoad(error="the script could not be inspected: unreadable k6 output")
+        max_vus = data.get("maxVUs")
+        total = parse_duration(str(data.get("totalDuration") or ""))
+        return ScriptLoad(
+            max_vus=int(max_vus) if isinstance(max_vus, (int, float)) else None,
+            total_seconds=total,
+            error="" if (isinstance(max_vus, (int, float)) and total is not None)
+            else "k6 did not report the script's peak users and duration",
+        )
+    except Exception as e:  # noqa: BLE001
+        return ScriptLoad(error=f"the script could not be inspected: {e}")
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
+def check_load(load: ScriptLoad, policy: Policy | None = None) -> list[str]:
+    """Reasons the script's load breaks the caps (empty list = within limits).
+
+    Fail closed: with a cap configured, an unknown load is itself a reason.
+    """
+    policy = policy or get_policy()
+    if not policy.max_users and not policy.max_duration_seconds:
+        return []
+    if not load.known:
+        return ["the run's size could not be checked against the safety limits — "
+                + (load.error or "unknown script load")]
+    reasons: list[str] = []
+    if policy.max_users and load.max_vus > policy.max_users:
+        reasons.append(f"the script reaches {load.max_vus} virtual users; "
+                       f"the limit is {policy.max_users}")
+    if policy.max_duration_seconds and (
+            load.total_seconds > policy.max_duration_seconds + DURATION_GRACE_SECONDS):
+        reasons.append(f"the script runs for {int(round(load.total_seconds))}s "
+                       f"(including k6's wind-down); the limit is "
+                       f"{policy.max_duration_seconds}s")
+    return reasons
+
+
+# ---------- the gate used before a run starts ----------
+
+@dataclass
+class Precheck:
+    reasons: list[str] = field(default_factory=list)
+
+    @property
+    def ok(self) -> bool:
+        return not self.reasons
+
+
+def precheck_run(*, target: str, content: str, active_runs: int,
+                 policy: Policy | None = None) -> Precheck:
+    """The instant checks: kill switch, allow-list (target + script URLs), concurrency.
+
+    The load caps need k6 and are checked by the runner just before launch.
+    """
+    policy = policy or get_policy()
+    out = Precheck()
+
+    ks = kill_switch()
+    if ks["engaged"]:
+        out.reasons.append("the kill switch is on — runs are paused"
+                           + (f" ({ks['reason']})" if ks.get("reason") else ""))
+        return out                      # nothing else matters
+
+    if policy.allowed_hosts:
+        out.reasons.extend(check_target(target, policy))
+        for url in script_urls(content):
+            if not host_allowed(url, policy.allowed_hosts):
+                reason = f"the script sends requests to {url}, which is not on the allow-list"
+                if reason not in out.reasons:
+                    out.reasons.append(reason)
+
+    if policy.max_concurrent and active_runs >= policy.max_concurrent:
+        out.reasons.append(f"{active_runs} run{'s are' if active_runs != 1 else ' is'} "
+                           f"already in progress; the limit is {policy.max_concurrent}")
+    return out
+
+
+# ---------- kill switch (durable, shared by every app process) ----------
+
+def kill_switch() -> dict:
+    """{'engaged': bool, 'reason': str, 'since': iso-time|''}. Fails closed to
+    'not engaged' only if the flag has never been set; a read error is treated as
+    engaged, because the switch exists for emergencies."""
+    try:
+        with get_session() as s:
+            row = s.get(AppStateRow, _KILL_SWITCH_KEY)
+            if row is None:
+                return {"engaged": False, "reason": "", "since": ""}
+            data = json.loads(row.value_json or "{}")
+            return {
+                "engaged": bool(data.get("engaged")),
+                "reason": str(data.get("reason") or ""),
+                "since": row.updated_at.isoformat() if data.get("engaged") else "",
+            }
+    except Exception as e:  # noqa: BLE001
+        _log.error("safety.kill_switch_read_failed", error=str(e))
+        return {"engaged": True, "reason": "safety state could not be read", "since": ""}
+
+
+def set_kill_switch(engaged: bool, reason: str = "") -> dict:
+    """Turn the kill switch on or off. Stopping the runs in progress is done by the
+    caller (the runner), which also polls this flag on every heartbeat."""
+    with get_session() as s:
+        row = s.get(AppStateRow, _KILL_SWITCH_KEY)
+        value = json.dumps({"engaged": bool(engaged), "reason": reason.strip()[:200]})
+        if row is None:
+            s.add(AppStateRow(key=_KILL_SWITCH_KEY, value_json=value))
+        else:
+            row.value_json = value
+        s.commit()
+    _log.warning("safety.kill_switch", engaged=bool(engaged), reason=reason)
+    return kill_switch()
+
