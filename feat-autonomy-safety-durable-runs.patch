+def test_allow_list_blocks_target_and_script_urls(runner, settings):
+    settings.run_allowed_hosts = "127.0.0.1"
+    with pytest.raises(RunBlocked) as e:
+        _start(runner, script(), target="http://prod.example.com")
+    assert "prod.example.com" in e.value.reasons[0]
+    with pytest.raises(RunBlocked):
+        _start(runner, script() + "http.get('http://other.example/x');")
+    assert runner._RUNS == {} and runner.active_runs() == []     # nothing was started
+    assert _settle(_start(runner, script())).status == "finished"
+
