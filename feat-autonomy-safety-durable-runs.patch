new file mode 100644
index 0000000..c610465
--- /dev/null
+++ b/src/perfagent/api/safety_routes.py
@@ -0,0 +1,62 @@
+"""API routes: the safety rails on load, and the runs currently in progress.
+
+  GET  /api/safety               the limits in force + kill-switch state + active runs
+  POST /api/safety/kill-switch   {"engaged": true|false, "reason": "..."}
+                                 on  -> stops every run in progress and refuses new ones
+                                 off -> runs are allowed again
+  GET  /api/runs/active          runs in progress (from the database, so it is correct
+                                 after a refresh or a restart) — used to reconnect
+
+The limits themselves are settings (RUN_ALLOWED_HOSTS, RUN_MAX_USERS,
+RUN_MAX_DURATION_SECONDS, RUN_MAX_CONCURRENT) and are enforced in the runner.
+"""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+from pydantic import BaseModel
+
+from perfagent import audit, safety
+from perfagent.runner import active_runs, stop_all_runs
+
+router = APIRouter()
+
+
+class KillSwitchBody(BaseModel):
+    engaged: bool
+    reason: str = ""
+
+
+def _state() -> dict:
+    return {
+        "policy": safety.get_policy().to_dict(),
+        "kill_switch": safety.kill_switch(),
+        "active_runs": len(active_runs()),
+        "duration_grace_seconds": safety.DURATION_GRACE_SECONDS,
+    }
+
+
+@router.get("/api/safety")
+def get_safety() -> dict:
+    return _state()
+
+
+@router.post("/api/safety/kill-switch")
+def set_kill_switch(body: KillSwitchBody) -> dict:
+    safety.set_kill_switch(body.engaged, body.reason)
+    stopped = 0
+    if body.engaged:
+        # Flag first, then stop: nothing new can start in between.
+        stopped = stop_all_runs("Stopped by the kill switch.")
+        audit.record("safety.kill_switch_on", entity="run",
+                     summary=f"Kill switch ON — {stopped} run(s) stopped"
+                             + (f" ({body.reason.strip()[:120]})" if body.reason.strip() else ""))
+    else:
+        audit.record("safety.kill_switch_off", entity="run",
+                     summary="Kill switch OFF — runs allowed again")
+    return {**_state(), "stopped": stopped}
+
+
+@router.get("/api/runs/active")
+def get_active_runs() -> dict:
+    return {"runs": active_runs()}
