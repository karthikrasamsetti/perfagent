+def test_watchdog_stops_a_run_that_outlives_the_duration_cap(runner, settings, monkeypatch):
+    settings.run_max_duration_seconds = 1
+    monkeypatch.setattr(safety, "DURATION_GRACE_SECONDS", 0)
+    monkeypatch.setattr(runner, "_WATCHDOG_SLACK_SECONDS", 0)
+    # claims 1s (passes the pre-check) but actually keeps going for 30s
+    run = _settle(_start(runner, script(secs=30, total=1)))
+    assert run.status == "stopped" and "duration limit" in run.message
+    assert (run.ended_at - run.started_at) < 15
+
