index 0000000..3e92a8e
--- /dev/null
+++ b/src/perfagent/runner/store.py
@@ -0,0 +1,271 @@
+"""Durable run state — the database side of the runner.
+
+The runner keeps a live RunState in memory for speed and mirrors it to the `runs`
+table: once when the run is created, about once a second while it runs (the
+"heartbeat"), and once when it ends. This module is that mirror, plus recovery:
+
+  - ``load``     rebuild a RunState from the table (a finished run after a restart).
+  - ``recover``  find runs that were in flight when their app process went away,
+                 mark them 'interrupted' (keeping the metrics they had), and stop a
+                 k6 process that was left behind — load must never keep firing with
+                 nothing watching it.
+
+Every write is best-effort: a database hiccup is logged and never breaks a run.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import socket
+import time
+
+import psutil
+
+from perfagent.db import RunRow, get_session
+from perfagent.logging_config import get_logger
+
+_log = get_logger("perfagent.runs")
+
+ACTIVE = ("starting", "preparing", "running")
+TERMINAL = ("finished", "error", "stopped", "blocked", "interrupted")
+
+# A run whose owner we cannot check directly (another machine) is treated as
+# orphaned once it has not saved its state for this long.
+STALE_AFTER_SECONDS = 30.0
+
+INTERRUPTED_MESSAGE = ("The app restarted while this run was in progress. The run was "
+                       "stopped; the results up to that point are kept.")
+
+
+# ---------- who owns a run ----------
+
+def _process_started(pid: int) -> int:
+    try:
+        return int(psutil.Process(pid).create_time())
+    except (psutil.Error, OSError):
+        return 0
+
+
+_HOST = socket.gethostname()
+_OWNER = f"{_HOST}|{os.getpid()}|{_process_started(os.getpid())}"
+
+
+def owner_id() -> str:
+    """This app process: host|pid|process-start-time (the start time guards against
+    a recycled pid)."""
+    return _OWNER
+
+
+def _owner_state(owner: str) -> str:
+    """'me' | 'alive' | 'dead' | 'unknown' (another machine, or unreadable)."""
+    if owner == _OWNER:
+        return "me"
+    try:
+        host, pid_s, started_s = owner.split("|")
+        pid, started = int(pid_s), int(started_s)
+    except ValueError:
+        return "unknown"
+    if host != _HOST:
+        return "unknown"
+    if psutil.pid_exists(pid) and _process_started(pid) == started:
+        return "alive"
+    return "dead"
+
+
+# ---------- write ----------
+
+def _apply(row: RunRow, run, *, with_logs: bool = True) -> None:
+    row.status = run.status
+    row.message = run.message or ""
+    row.started_at = float(run.started_at or 0.0)
+    row.ended_at = float(run.ended_at or 0.0)
+    row.heartbeat_at = time.time()
+    row.snapshot_json = json.dumps(run.snapshot or {})
+    if with_logs:
+        row.logs_json = json.dumps(list(run.logs or []))
+    row.max_vus = int(run.max_vus or 0)
+    row.total_seconds = float(run.total_seconds or 0.0)
+    row.k6_pid = int(run.k6_pid or 0)
+    row.k6_started = float(run.k6_started or 0.0)
+
+
+def insert(run) -> bool:
+    """Create the run's row. Returns False if it could not be written."""
+    try:
+        with get_session() as s:
+            row = RunRow(
+                id=run.run_id, script_id=run.script_id or "", plan_id=run.plan_id or "",
+                tool=run.tool, target=run.target or "",
+                load_model_json=run.load_model_json or "", owner=_OWNER,
+            )
+            _apply(row, run)
+            s.add(row)
+            s.commit()
+        return True
+    except Exception as e:  # noqa: BLE001
+        _log.warning("runs.insert_failed", run_id=run.run_id, error=str(e))
+        return False
+
+
+def save(run, *, with_logs: bool = True) -> bool:
+    """Save the run's current state (the heartbeat). Returns True if the row asks
+    this run to stop (a stop requested from another process)."""
+    try:
+        with get_session() as s:
+            row = s.get(RunRow, run.run_id)
+            if row is None:
+                return False
+            _apply(row, run, with_logs=with_logs)
+            stop = bool(row.stop_requested)
+            s.commit()
+            return stop
+    except Exception as e:  # noqa: BLE001
+        _log.warning("runs.save_failed", run_id=run.run_id, error=str(e))
+        return False
+
+
+def request_stop(run_id: str) -> bool:
+    """Ask the process that owns an active run to stop it. True if it was active."""
+    try:
+        with get_session() as s:
+            row = s.get(RunRow, run_id)
+            if row is None or row.status not in ACTIVE:
+                return False
+            row.stop_requested = True
+            s.commit()
+            return True
+    except Exception as e:  # noqa: BLE001
+        _log.warning("runs.request_stop_failed", run_id=run_id, error=str(e))
+        return False
+
+
+# ---------- read ----------
+
+def _to_state(row: RunRow):
+    from perfagent.runner.k6_runner import RunState
+
+    def _json(text: str, default):
+        try:
+            return json.loads(text) if text else default
+        except json.JSONDecodeError:
+            return default
+
+    return RunState(
+        run_id=row.id, script_id=row.script_id, tool=row.tool, target=row.target,
+        status=row.status, started_at=row.started_at or 0.0,
+        ended_at=(row.ended_at or None), message=row.message or "",
+        load_model_json=row.load_model_json or "",
+        snapshot=_json(row.snapshot_json, {}), logs=_json(row.logs_json, []),
+        plan_id=row.plan_id or "", max_vus=row.max_vus or 0,
+        total_seconds=row.total_seconds or 0.0,
+        k6_pid=row.k6_pid or 0, k6_started=row.k6_started or 0.0,
+    )
+
+
+def load(run_id: str, local_ids: set[str] | frozenset[str] = frozenset()):
+    """Rebuild a RunState from the database, or None. An in-flight run whose owner
+    is gone is marked interrupted first."""
+    try:
+        with get_session() as s:
+            row = s.get(RunRow, run_id)
+            if row is None:
+                return None
+            if row.status in ACTIVE and _is_orphan(row, local_ids):
+                _interrupt(row)
+                s.commit()
+            return _to_state(row)
+    except Exception as e:  # noqa: BLE001
+        _log.warning("runs.load_failed", run_id=run_id, error=str(e))
+        return None
+
+
+def active(local_ids: set[str] | frozenset[str] = frozenset()) -> list[dict]:
+    """Runs in progress (after recovering orphans), newest first."""
+    recover(local_ids)
+    try:
+        with get_session() as s:
+            rows = (s.query(RunRow).filter(RunRow.status.in_(ACTIVE))
+                    .order_by(RunRow.created_at.desc()).all())
+            return [
+                {
+                    "run_id": r.id, "script_id": r.script_id, "plan_id": r.plan_id,
+                    "tool": r.tool, "target": r.target, "status": r.status,
+                    "started_at": r.started_at, "max_vus": r.max_vus,
+                    "total_seconds": r.total_seconds,
+                    "local": r.id in local_ids,
+                }
+                for r in rows
+            ]
+    except Exception as e:  # noqa: BLE001
+        _log.warning("runs.active_failed", error=str(e))
+        return []
+
+
+# ---------- recovery ----------
+
+def _is_orphan(row: RunRow, local_ids) -> bool:
+    if row.id in local_ids:
+        return False                               # running right here
+    state = _owner_state(row.owner or "")
+    if state in ("me", "dead"):
+        return True                                # this process has no such run / owner gone
+    stale = (time.time() - (row.heartbeat_at or 0.0)) > STALE_AFTER_SECONDS
+    return stale                                   # alive/unknown owner: trust the heartbeat
+
+
+def _looks_like_k6(proc: psutil.Process) -> bool:
+    try:
+        return "k6" in (proc.name() or "").lower()
+    except (psutil.Error, OSError):
+        return False
+
+
+def stop_leftover_process(pid: int, started: float) -> bool:
+    """Terminate the k6 process a dead app process left behind. Only if it is
+    provably the same process (same pid AND start time AND it is k6)."""
+    if not pid:
+        return False
+    try:
+        proc = psutil.Process(pid)
+        if abs(proc.create_time() - (started or 0.0)) > 2.0 or not _looks_like_k6(proc):
+            return False
+        proc.terminate()
+        _log.warning("runs.leftover_k6_stopped", pid=pid)
+        return True
+    except (psutil.Error, OSError):
+        return False
+
+
+def _interrupt(row: RunRow) -> None:
+    host = (row.owner or "").split("|")[0]
+    if host == _HOST:
+        stop_leftover_process(row.k6_pid or 0, row.k6_started or 0.0)
+    row.status = "interrupted"
+    row.message = INTERRUPTED_MESSAGE
+    row.ended_at = row.heartbeat_at or time.time()
+    _log.warning("runs.interrupted", run_id=row.id, target=row.target)
+
+
+def recover(local_ids: set[str] | frozenset[str] = frozenset()) -> int:
+    """Mark every orphaned in-flight run as interrupted. Returns how many."""
+    try:
+        with get_session() as s:
+            rows = s.query(RunRow).filter(RunRow.status.in_(ACTIVE)).all()
+            n = 0
+            for row in rows:
+                if _is_orphan(row, local_ids):
+                    _interrupt(row)
+                    n += 1
+            if n:
+                s.commit()
+            return n
+    except Exception as e:  # noqa: BLE001
+        _log.warning("runs.recover_failed", error=str(e))
+        return 0
+
+
+__all__ = [
+    "ACTIVE", "TERMINAL", "owner_id", "insert", "save", "request_stop", "load", "active",
+    "recover", "stop_leftover_process", "INTERRUPTED_MESSAGE", "STALE_AFTER_SECONDS",
+]
