+"""Safety rails on load + durable run state.
+
+The runner is driven with a small fake k6 (a Python script that prints k6-style JSON
+points), so these tests run anywhere without the real engine. One test uses the real
+k6 if it is already on the machine.
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+import time
+import uuid
+
+import pytest
+
+from perfagent import safety
+from perfagent.config import Settings
+from perfagent.safety import Policy, RunBlocked, ScriptLoad
+
+# ---------------------------------------------------------------- fixtures ----
+
+FAKE_K6 = r'''
+import json, re, sys, time
+src = open(sys.argv[1], encoding="utf-8").read()
+secs = float(re.search(r"FAKE secs=([\d.]+)", src).group(1))
+urls = re.findall(r"FAKE url=(\S+)", src) or ["http://127.0.0.1:8000/x"]
+sys.stderr.write("fake k6 starting\n"); sys.stderr.flush()
+end = time.time() + secs
+while time.time() < end:
+    for u in urls:
+        points = (("http_reqs", 1), ("http_req_duration", 12.5), ("http_req_failed", 0))
+        for metric, value in points:
+            print(json.dumps({"type": "Point", "metric": metric,
+                              "data": {"time": "t", "value": value,
+                                       "tags": {"name": "x", "url": u, "status": "200"}}}),
+                  flush=True)
+    time.sleep(0.05)
+'''
+
+
+def script(secs=0.4, vus=2, total=None, urls=()):
+    """A 'script' the fake engine and the fake inspector both understand."""
+    total = secs if total is None else total
+    lines = [f"// FAKE secs={secs}", f"// LOAD vus={vus} total={total}"]
+    lines += [f"// FAKE url={u}" for u in urls]
+    return "\n".join(lines) + "\nexport default function () {}\n"
+
+
+def _fake_inspect(content, *_a, **_k):
+    import re
+    m = re.search(r"LOAD vus=(\d+) total=([\d.]+)", content)
+    if not m:
+        return ScriptLoad(error="not inspectable")
+    return ScriptLoad(max_vus=int(m.group(1)), total_seconds=float(m.group(2)))
+
+
+@pytest.fixture()
+def db(tmp_path, monkeypatch):
+    from sqlalchemy import create_engine
+
+    from perfagent.db import models as dbmodels
+    dbmodels._engine = None
+    eng = create_engine(f"sqlite:///{tmp_path / 't.db'}")
+    dbmodels.Base.metadata.create_all(eng)
+    monkeypatch.setattr(dbmodels, "get_engine", lambda *a, **k: eng)
+    yield tmp_path
+    eng.dispose()
+
+
+@pytest.fixture()
+def settings(monkeypatch):
+    from perfagent.runner import k6_runner
+    s = Settings(_env_file=None, run_heartbeat_seconds=0.05)
+    monkeypatch.setattr(safety, "get_settings", lambda: s)
+    monkeypatch.setattr(k6_runner, "get_settings", lambda: s)
+    return s
+
+
+@pytest.fixture()
+def runner(db, settings, monkeypatch):
+    """The runner wired to the fake engine, with a clean registry."""
+    from perfagent.runner import k6_runner
+    fake = db / "fake_k6.py"
+    fake.write_text(FAKE_K6, encoding="utf-8")
+    monkeypatch.setattr(k6_runner, "ensure_k6", lambda: sys.executable)
+    monkeypatch.setattr(k6_runner, "find_k6", lambda: sys.executable)
+    monkeypatch.setattr(k6_runner, "_k6_command",
+                        lambda _k6, path: [sys.executable, str(fake), str(path)])
+    monkeypatch.setattr(safety, "inspect_script_load", _fake_inspect)
+    k6_runner._RUNS.clear()
+    yield k6_runner
+    for r in list(k6_runner._RUNS.values()):        # never leave a child running
+        k6_runner._terminate(r, "test cleanup")
+        r._done.wait(5)
+    k6_runner._RUNS.clear()
+
+
+def _start(runner, content, target="http://127.0.0.1:8000", **kw):
+    return runner.start_run(run_id=uuid.uuid4().hex, script_id="s1", tool="k6",
+                            target=target, content=content, **kw)
+
+
+def _settle(run, timeout=15):
+    assert run._done.wait(timeout), f"run did not finish (status {run.status})"
+    return run
+
+
+def _wait_running(run, timeout=10):
+    end = time.time() + timeout
+    while time.time() < end and run.status != "running":
+        time.sleep(0.02)
+    assert run.status == "running", run.status
+
+
+# ------------------------------------------------------------ safety: unit ----
+
+def test_host_allow_list_matching():
+    assert safety.host_allowed("http://anything.example", ())            # empty = any
+    allowed = ("127.0.0.1:8000", "staging.example.com", "*.test.example.com")
+    assert safety.host_allowed("http://127.0.0.1:8000/x", allowed)
+    assert not safety.host_allowed("http://127.0.0.1:9000/x", allowed)   # other port
+    assert safety.host_allowed("https://STAGING.example.com/a?b=1", allowed)
+    assert safety.host_allowed("https://staging.example.com:8443", allowed)  # any port
+    assert safety.host_allowed("https://api.test.example.com", allowed)
+    assert not safety.host_allowed("https://test.example.com", allowed)  # bare domain
+    assert not safety.host_allowed("https://evil.com/staging.example.com", allowed)
+    assert not safety.host_allowed("https://staging.example.com.evil.com", allowed)
+    assert not safety.host_allowed("", allowed)
+
+
+def test_script_urls_ignore_comments_and_imports():
+    src = """// see https://k6.io/docs for help
+/* block https://block.example */
+import { uuidv4 } from 'https://jslib.k6.io/k6-utils/1.4.0/index.js';
+const BASE_URL = __ENV.BASE_URL || 'http://127.0.0.1:8000';
+http.get('https://API.other.example:8443/x');
+"""
+    assert safety.script_urls(src) == ["http://127.0.0.1:8000", "https://api.other.example:8443"]
+
+
+@pytest.mark.parametrize("text,secs", [
+    ("1m31s", 91), ("30s", 30), ("2h", 7200), ("1h2m3.5s", 3723.5), ("500ms", 0.5), ("0", 0),
+])
+def test_parse_duration(text, secs):
+    assert safety.parse_duration(text) == pytest.approx(secs)
+
+
+def test_parse_duration_rejects_garbage():
+    assert safety.parse_duration("soon") is None and safety.parse_duration("") is None
+
+
+def test_load_caps():
+    p = Policy(max_users=100, max_duration_seconds=600)
+    assert safety.check_load(ScriptLoad(100, 600), p) == []
+    assert safety.check_load(ScriptLoad(100, 600 + safety.DURATION_GRACE_SECONDS), p) == []
+    r = safety.check_load(ScriptLoad(101, 600 + safety.DURATION_GRACE_SECONDS + 1), p)
+    assert len(r) == 2 and "101 virtual users" in r[0] and "limit is 600s" in r[1]
+
+
+def test_load_caps_fail_closed_when_load_is_unknown():
+    r = safety.check_load(ScriptLoad(error="could not inspect"), Policy(max_users=10))
+    assert len(r) == 1 and "could not be checked" in r[0]
+    # no caps configured -> nothing to check, so an unknown load is fine
+    assert safety.check_load(ScriptLoad(error="x"), Policy()) == []
+
+
+def test_kill_switch_is_durable(db):
+    assert safety.kill_switch()["engaged"] is False
+    st = safety.set_kill_switch(True, "incident 42")
+    assert st["engaged"] and st["reason"] == "incident 42" and st["since"]
+    assert safety.kill_switch()["engaged"] is True              # read back from the DB
+    assert safety.set_kill_switch(False)["engaged"] is False
+
+
+def test_precheck(db):
+    p = Policy(allowed_hosts=("127.0.0.1",), max_concurrent=1)
+    ok = safety.precheck_run(target="http://127.0.0.1:8000", content=script(),
+                             active_runs=0, policy=p)
+    assert ok.ok
+    bad = safety.precheck_run(target="http://prod.example.com",
+                              content="http.get('http://other.example/x')", active_runs=1, policy=p)
+    assert len(bad.reasons) == 3
+    safety.set_kill_switch(True)
+    ks = safety.precheck_run(target="http://127.0.0.1", content="", active_runs=0, policy=p)
+    assert len(ks.reasons) == 1 and "kill switch" in ks.reasons[0]
+
+
+def test_inspect_with_the_real_engine_if_present():
+    from perfagent.runner.k6_binary import find_k6
+    if find_k6() is None:
+        pytest.skip("k6 is not on this machine yet")
+    load = safety.inspect_script_load(
+        "import http from 'k6/http';\n"
+        "export const options = { vus: 7, duration: '45s' };\n"
+        "export default function () { http.get('http://127.0.0.1:8000/'); }\n")
+    assert load.known and load.max_vus == 7 and 45 <= load.total_seconds <= 90
+    assert not safety.inspect_script_load("this is not javascript (").known
+
+
+# ------------------------------------------------------ runner: durability ----
+
+def test_run_is_saved_and_survives_a_restart(runner):
+    run = _settle(_start(runner, script(secs=0.5), plan_id="p1"))
+    assert run.status == "finished" and run.snapshot["requests"] > 0
+    assert run.max_vus == 2 and run.k6_pid > 0
+
+    runner._RUNS.clear()                              # "restart": memory is gone
+    again = runner.get_run(run.run_id)
+    assert again is not None and again is not run
+    assert again.status == "finished" and again.plan_id == "p1"
+    assert again.snapshot["requests"] == run.snapshot["requests"]
+    assert any("fake k6 starting" in line for line in again.logs)
+    assert again.ended_at and again.max_vus == 2
+    assert runner.get_run("nope") is None
+
+
+def test_state_is_saved_while_running(runner):
+    from perfagent.db import RunRow, get_session
+    run = _start(runner, script(secs=3))
+    _wait_running(run)
+    time.sleep(0.5)                                   # a few heartbeats
+    with get_session() as s:
+        row = s.get(RunRow, run.run_id)
+        assert row.status == "running" and row.k6_pid == run.k6_pid
+        assert json.loads(row.snapshot_json).get("requests", 0) > 0
+        assert time.time() - row.heartbeat_at < 2
+    assert [r["run_id"] for r in runner.active_runs()] == [run.run_id]
+    assert runner.stop_run(run.run_id)
+    _settle(run)
+    assert run.status == "stopped" and run.message == "Stopped by user."
+    assert runner.active_runs() == []
+
+
+def _orphan_row(owner, heartbeat_age=0.0, pid=0, started=0.0):
+    from perfagent.db import RunRow, get_session
+    rid = uuid.uuid4().hex
+    with get_session() as s:
+        s.add(RunRow(id=rid, status="running", target="http://x", owner=owner,
+                     heartbeat_at=time.time() - heartbeat_age, started_at=time.time() - 5,
+                     snapshot_json=json.dumps({"requests": 42}), k6_pid=pid, k6_started=started))
+        s.commit()
+    return rid
+
+
+def test_runs_orphaned_by_a_dead_process_are_interrupted(runner):
+    from perfagent.runner import store
+    host = store.owner_id().split("|")[0]
+    dead = _orphan_row(f"{host}|999999|1")                       # that process is gone
+    elsewhere_fresh = _orphan_row("other-host|1|1", heartbeat_age=1)
+    elsewhere_stale = _orphan_row("other-host|1|1", heartbeat_age=store.STALE_AFTER_SECONDS + 5)
+
+    assert runner.recover_interrupted_runs() == 2
+    r = runner.get_run(dead)
+    assert r.status == "interrupted" and r.snapshot == {"requests": 42} and r.ended_at
+    assert "restarted" in r.message
+    assert runner.get_run(elsewhere_stale).status == "interrupted"
+    assert runner.get_run(elsewhere_fresh).status == "running"   # still owned and alive
+    assert [a["run_id"] for a in runner.active_runs()] == [elsewhere_fresh]
+
+
+def test_get_run_recovers_lazily(runner):
+    from perfagent.runner import store
+    rid = _orphan_row(store.owner_id())        # "ours", but this process has no such run
+    assert runner.get_run(rid).status == "interrupted"
+
+
+def test_leftover_engine_process_is_stopped_only_if_it_is_provably_ours(runner, monkeypatch):
+    import psutil
+
+    from perfagent.runner import store
+    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
+    try:
+        started = psutil.Process(child.pid).create_time()
+        assert not store.stop_leftover_process(child.pid, started)        # not k6 -> untouched
+        monkeypatch.setattr(store, "_looks_like_k6", lambda _p: True)
+        assert not store.stop_leftover_process(child.pid, started - 100)  # pid reused -> untouched
+        assert child.poll() is None
+        assert store.stop_leftover_process(child.pid, started)            # same process -> stopped
+        child.wait(10)
+        assert not store.stop_leftover_process(0, 0)
+    finally:
+        if child.poll() is None:
+            child.kill()
+
