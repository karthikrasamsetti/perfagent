+def test_report_works_after_a_restart_and_a_finished_run_can_pass(client, runner):
+    sid = _upload(client, script(secs=0.5))
+    rid = client.post(f"/api/scripts/{sid}/run").json()["run_id"]
+    assert _wait_api(client, rid)["status"] == "finished"
+    runner._RUNS[rid]._done.wait(5)
+    runner._RUNS.clear()                                       # "restart"
+    j = client.get(f"/api/runs/{rid}").json()
+    assert j["status"] == "finished" and j["snapshot"]["requests"] > 0 and j["max_vus"] == 2
+    rep = client.get(f"/api/runs/{rid}/report")
+    assert rep.status_code == 200
+    verdict = rep.json()["verdict"]
+    assert verdict["overall_passed"] is True and "incomplete" not in verdict
+
+
+def test_blocked_run_has_no_report(client, settings):
+    settings.run_max_users = 1
+    sid = _upload(client, script(vus=5))
+    rid = client.post(f"/api/scripts/{sid}/run").json()["run_id"]
+    assert _wait_api(client, rid)["status"] == "blocked"
+    r = client.get(f"/api/runs/{rid}/report")
+    assert r.status_code == 400 and "blocked" in r.json()["detail"]
