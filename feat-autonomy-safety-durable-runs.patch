+@pytest.fixture()
+def client(runner, monkeypatch):
+    from fastapi.testclient import TestClient
+
+    from perfagent.api import app as appmod
+
+    def _no_llm(*_a, **_k):                 # reports fall back to the deterministic text
+        raise ValueError("no LLM in tests")
