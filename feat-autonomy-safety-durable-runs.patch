+def test_run_over_the_caps_is_blocked_before_any_load(runner, settings):
+    settings.run_max_users = 10
+    run = _settle(_start(runner, script(vus=50)))
+    assert run.status == "blocked" and "50 virtual users" in run.message
+    assert run.k6_pid == 0 and run.snapshot == {}                # the engine never started
+    assert runner.get_run(run.run_id).status == "blocked"
+
+    settings.run_max_users, settings.run_max_duration_seconds = 0, 60
+    run = _settle(_start(runner, script(total=600)))
+    assert run.status == "blocked" and "limit is 60s" in run.message
+
+
+def test_unknown_load_is_blocked_when_a_cap_is_set(runner, settings):
+    run = _settle(_start(runner, "// FAKE secs=0.2\n"))          # the inspector can't read it
+    assert run.status == "blocked" and "could not be checked" in run.message
+    settings.run_max_users = settings.run_max_duration_seconds = 0
+    assert _settle(_start(runner, "// FAKE secs=0.2\n")).status == "finished"
+
