+def test_stop_before_the_engine_starts(runner, monkeypatch):
+    gate = __import__("threading").Event()
+
+    def slow_inspect(content, *a, **k):
+        gate.wait(5)
+        return _fake_inspect(content)
+    monkeypatch.setattr(safety, "inspect_script_load", slow_inspect)
+    run = _start(runner, script(secs=20))
+    assert runner.stop_run(run.run_id)
+    gate.set()
+    _settle(run)
+    assert run.status == "stopped" and run.k6_pid == 0           # never launched
